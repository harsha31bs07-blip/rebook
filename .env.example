PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Sandbox only. Unset defaults to sandbox; every other value is rejected.
PAYPAL_ENV=sandbox
PAYPAL_WEBHOOK_ID=
DATA_DIR=
DEMO_REAL_CAPTURES=
# Demo cache on Render Free: all local records disappear on restart/redeploy/spin-down.
# Limits are per Node process and reset on restart. Run a single process/instance.
DEMO_WARM_POOL=1
# Foreground slots; warm-pool filling has one additional dedicated slot.
MAX_CONCURRENT_PREPARATIONS=2
MAX_WORKSPACE_CREATIONS_PER_HOUR=60
MAX_REAL_CAPTURES_PER_HOUR=1500
MAX_APPROVALS_PER_MIN=20
AI_CALLS_PER_MIN=30
AI_CALLS_PER_DAY=1200
# Delegation uses several parallel turns and model fallbacks; global quotas still cap all attempts.
AI_CLIENT_CALLS_PER_MIN=24
AI_WORKSPACE_CALLS_PER_MIN=24
AI_MAX_CONCURRENT=4
# Gemini first; Groq takes small requests when Gemini is busy. Keys are server only.
GEMINI_API_KEY=
GROQ_API_KEY=
# Ordered provider:model chain. Entries without a configured provider key are skipped.
AI_MODELS=gemini:gemini-flash-lite-latest,groq:openai/gpt-oss-120b,gemini:gemini-3.5-flash,groq:openai/gpt-oss-20b,groq:qwen/qwen3.8-27b,gemini:gemini-flash-latest
# Legacy all-Gemini chain, used only when AI_MODELS is unset.
# GEMINI_MODELS=gemini-flash-lite-latest,gemini-3.5-flash,gemini-flash-latest
# Groq input estimate: ceil(UTF-8 JSON body bytes / 8), measured on real Studio turns. Larger turns stay on Gemini.
GROQ_MAX_INPUT_TOKENS=7000
# Optional AG Studio licence; without it Studio displays its trial watermark.
NEXT_PUBLIC_AG_STUDIO_LICENSE=
# Framework supplied: NODE_ENV, NEXT_RUNTIME. Render supplies PORT to next start.
